# Local Docker Compose values. Copy this file to `.env` (real `.env` is gitignored).
# For AWS production, these values are sourced from AWS Systems Manager
# Parameter Store and injected by the ECS task definition.

# Environment flag. Leave empty (or set to "development") for local Docker.
# In ECS production: NODE_ENV=production.
NODE_ENV=

# Backend port (exposed by docker-compose api service).
PORT=5002

# MySQL connection (matches the `mysql` service in docker-compose.yml).
DB_HOST=mysql
DB_PORT=3306
DB_NAME=online_store
DB_USER=app_user
DB_PASS=app_password

# Used only by the mysql container to initialise root.
# Application code never uses the root account.
DB_ROOT_PASSWORD=root_password_change_me

# JWT signing secret. Change for any real deployment.
# Production: sourced from /cs436-ecommerce/jwt/secret in Parameter Store.
JWT_SECRET=dev_jwt_secret_change_me

# CORS origin allowed by the API. Empty defaults to http://localhost:5173 (Vite dev server).
# Production: set to the CloudFront distribution URL.
CORS_ORIGIN=

# AWS region for the SES SDK. Empty in local dev triggers the Nodemailer
# fallback (set EMAIL_USER + EMAIL_PASS below). In production this is the
# region of the SES sender identity, e.g. eu-west-1.
AWS_REGION=

# SES verified sender address (used as the From: header).
# Must be a verified identity in SES; in production mode SES can also send to
# unverified recipients.
EMAIL_FROM=

# Local dev SMTP fallback only (Gmail App Password). Used when AWS_REGION
# is empty and we want local email testing. Leave blank to disable email
# entirely in local dev (the seeder + checkout work without it).
EMAIL_USER=
EMAIL_PASS=
